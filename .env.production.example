# =================================================================
# WorkPilot / WORKPILOT — AWS Production Environment Configuration
# =================================================================
# Instructions:
# 1. Store secrets in AWS Secrets Manager or Systems Manager Parameter Store.
# 2. Inject environment variables into AWS ECS / Elastic Beanstalk / App Runner.
# =================================================================

# -----------------------------------------------------------------
# 1. AWS Backend Server Configuration (Express ECS/EC2)
# -----------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Frontend Application Origin for Strict Production CORS (comma-separated)
CLIENT_URL=http://13.53.169.49,http://13.53.169.49:3000,http://localhost:3000

# PostgreSQL Connection URL
# Default: in-host Docker PostgreSQL container
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/workpilot
# For external AWS RDS or Neon.tech:
# DATABASE_URL=postgresql://user:password@host:5432/workpilot?sslmode=require

# Cryptographically Strong JWT Secret (min 64 characters)
JWT_SECRET=GENERATE_HIGH_ENTROPY_64_CHAR_SECRET_KEY_FOR_PRODUCTION
DATA_ENCRYPTION_KEY=GENERATE_A_DIFFERENT_HIGH_ENTROPY_64_CHAR_KEY
JWT_EXPIRES_IN=7d

# Unipile API Production Credentials (https://developer.unipile.com/)
UNIPILE_DSN=https://api1.unipile.com:13200
UNIPILE_API_KEY=YOUR_PRODUCTION_UNIPILE_API_KEY
UNIPILE_WEBHOOK_SECRET=GENERATE_HIGH_ENTROPY_WEBHOOK_SECRET

# Razorpay Subscriptions
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME
RAZORPAY_KEY_SECRET=GENERATE_OR_COPY_FROM_RAZORPAY
RAZORPAY_WEBHOOK_SECRET=GENERATE_HIGH_ENTROPY_WEBHOOK_SECRET
RAZORPAY_PLAN_PRO_MONTHLY=plan_REPLACE_ME
RAZORPAY_PLAN_PRO_YEARLY=plan_REPLACE_ME

# Transactional email
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=WORKPILOT <no-reply@your-verified-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# Optional: Redis URL (leave empty to use local container or in-memory)
# REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------
# 2. AWS Frontend Client Configuration (Next.js Client)
# -----------------------------------------------------------------
# Backend API base URL accessible from the browser
NEXT_PUBLIC_SERVER_URL=http://13.53.169.49
NEXT_PUBLIC_API_URL=http://13.53.169.49

# Google Gemini AI Autonomous Agent Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY
