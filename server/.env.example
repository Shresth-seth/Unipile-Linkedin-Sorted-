# ==============================================
# WORKPILOT - Server Environment Configuration
# ==============================================

# Server Port
PORT=4000

# Frontend Client URL (used for CORS configuration)
CLIENT_URL=http://localhost:3000

# Environment Mode (development | production | test)
NODE_ENV=development

# -------------------------------------------------------------
# Database Configuration (PostgreSQL / Neon / SQLite)
# -------------------------------------------------------------
# Connection string for your relational database:
DATABASE_URL=postgresql://neondb_owner:password@ep-little-recipe.us-east-2.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------------------------
# Authentication & Security
# -------------------------------------------------------------
# Secret key used to sign and verify user JWT sessions
JWT_SECRET=your_jwt_secret_key_change_in_production
DATA_ENCRYPTION_KEY=your_separate_data_encryption_key_change_in_production
JWT_EXPIRES_IN=7d

# -------------------------------------------------------------
# Unipile API Configuration (LinkedIn Integration Gateway)
# -------------------------------------------------------------
# Retrieve your API Key and DSN from your Unipile dashboard:
# https://dashboard.unipile.com -> Settings -> API Keys & Endpoints
#
# UNIPILE_DSN: Your dedicated Unipile gateway URL (e.g., https://api61.unipile.com:19115)
UNIPILE_DSN=https://your-dsn-domain.unipile.com:port

# UNIPILE_API_KEY: Generated Access Token / X-API-KEY from Unipile
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_WEBHOOK_SECRET=your_unipile_webhook_secret_here

# Razorpay subscriptions
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_PLAN_PRO_MONTHLY=plan_replace_me
RAZORPAY_PLAN_PRO_YEARLY=plan_replace_me
RESEND_API_KEY=re_replace_me
EMAIL_FROM=WORKPILOT <no-reply@example.com>
SUPPORT_EMAIL=support@example.com

# -------------------------------------------------------------
# Google Gemini AI Agent Configuration (LangGraph Autonomous Engine)
# -------------------------------------------------------------
# Gemini Model Identifier (e.g. gemini-3.5-flash-lite, gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Gemini API Key:
# Obtain your key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
