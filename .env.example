# =================================================================
# WORKPILOT - Environment Configuration Template
# =================================================================
# Copy the relevant variables to:
#   - server/.env        (for the backend Express server)
#   - client/.env.local  (for the Next.js frontend client)
# =================================================================

# -----------------------------------------------------------------
# 1. Backend Server Configuration (server/.env)
# -----------------------------------------------------------------
# Port number for the Express server to listen on
PORT=4000

# Client frontend URL allowed by CORS
CLIENT_URL=http://localhost:3000

# Environment mode (development | production | test)
NODE_ENV=development

# Database Connection (PostgreSQL / Neon / SQLite)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Authentication & JWT Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Unipile API Configuration (https://developer.unipile.com/)
# Used for:
#  - Native LinkedIn Credentials Login (Username/Password)
#  - Session Cookie Login (li_at & li_a)
#  - Checkpoint Resolution (2FA, OTP, In-App mobile push validation)
#  - Profile Retrieval (GET /api/v1/users/{identifier})
#  - People & Keyword Search (POST /api/v1/linkedin/search)
#  - Connection Requests (POST /api/v1/users/invite)
UNIPILE_DSN=https://your-dsn-domain.unipile.com:port
UNIPILE_API_KEY=your_unipile_api_key_here

# -----------------------------------------------------------------
# 2. Frontend Client Configuration (client/.env.local or client/.env)
# -----------------------------------------------------------------
# Backend API base URL accessible from the browser / AxiosInstance
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
