{
  "family": "workpilot-production",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/workpilotTaskRole",
  "containerDefinitions": [
    {
      "name": "workpilot-server",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/workpilot-server:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "4000" },
        {
          "name": "CLIENT_URL",
          "value": "https://app.workpilot.io"
        },
        {
          "name": "GEMINI_MODEL",
          "value": "gemini-3.5-flash-lite"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:workpilot/DATABASE_URL"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:workpilot/JWT_SECRET"
        },
        {
          "name": "UNIPILE_DSN",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:workpilot/UNIPILE_DSN"
        },
        {
          "name": "UNIPILE_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:workpilot/UNIPILE_API_KEY"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:workpilot/GEMINI_API_KEY"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:4000/api/health/liveness || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/workpilot-production",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "server"
        }
      }
    },
    {
      "name": "workpilot-client",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/workpilot-client:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "PORT", "value": "3000" },
        { "name": "NEXT_PUBLIC_SERVER_URL", "value": "https://api.workpilot.io" },
        { "name": "NEXT_PUBLIC_API_URL", "value": "https://api.workpilot.io" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/workpilot-production",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "client"
        }
      }
    }
  ]
}
